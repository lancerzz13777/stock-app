# Copy this file to ".env" and fill in real values. Never commit .env or share it.

# Telegram alerts (free) - token from @BotFather; then run "python main.py telegram-test" to get your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# FREE chat advisor - key from https://aistudio.google.com/apikey (no card needed)
GEMINI_API_KEY=

# OPTIONAL and PAID - only if you set news.ai_tagging: true in config.yaml. Leave empty to stay free.
ANTHROPIC_API_KEY=

# LIVE PRICES (free with an Angel One account) - see menu option L for the steps
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_MPIN=
ANGEL_TOTP_SECRET=

# Future broker API keys - leave empty. Auto-trading is not built and stays OFF.
BROKER_API_KEY=
BROKER_API_SECRET=
